#!/usr/bin/env bash
# fleet — model benchmark/rank tooling autonomous rig (bin/run).
# Primary operation: benchmark + rank fleet models through llama-swap config.
#   bin/run                 dry-run (plans the benchmark; needs llama-swap/config.yaml)
#   bin/run --full          real benchmark (launches llama-server — heavyweight)
# NOTE: both paths require the external llama-swap/config.yaml runtime dependency
# (currently not provisioned in the estate, so --dry-run reports the gap clearly).
set -euo pipefail
cd "$(dirname "$0")/.."

cmd_bun="$(readlink -f "$(command -v bun 2>/dev/null || true)" 2>/dev/null || true)"
for cand in /home/toxic/.bun/bin/bun "$cmd_bun" /usr/local/bin/bun /usr/bin/bun; do
  [ -x "$cand" ] && { REAL_BUN="$cand"; break; }
done
[ -n "${REAL_BUN:-}" ] || { echo "FAIL: bun not found"; exit 1; }

if [ "${1:-}" = "--full" ]; then
    echo "== fleet run: FULL benchmark (launches llama-server; heavyweight) =="
    exec "$REAL_BUN" run fleet_config_ranker.ts
fi

echo "== fleet run: dry-run benchmark plan (no llama launch) =="
if ! "$REAL_BUN" run fleet_config_ranker.ts --dry-run 2>&1 | tee /tmp/fleet-run.log; then
  echo "WARN: dry-run could not complete — external llama-swap/config.yaml not provisioned."
  echo "      Code health is verified by bin/check. Provide the config to run benchmarks."
  exit 1
fi