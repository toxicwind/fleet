# Fleet ports — numeric SSOT
# Authoritative registry. UPPER_SNAKE_*_PORT = <port>. This file is the
# numeric truth; docs defer to it.

# --- Android (android-fleet) ---
# luaj-dropin: Lua-over-HTTP control plane
LUAJ_DROPIN_TV_PORT=38383    # Hisense TV (OwnTV app server)
LUAJ_DROPIN_PIXEL_PORT=38384 # Pixel (via adb forward tcp:38384 tcp:38383)

# flotilla MCP: Android device control (Pixel)
FLOTILLA_MCP_PORT=25245

# --- Kodi (kodi-fleet) ---
KODI_RPC_PORT=8080

# --- webOS (lg-fleet) ---
LG_HOT_BRIDGE_PORT=18080    # lg-hot live-reload + blue-green sync bridge

# --- Estate control-plane (not fleet-owned, for reference) ---
# thresher MCP gateway :25127
# blackbird MCP :25113
# mimetite router :25193
# argos index :25254